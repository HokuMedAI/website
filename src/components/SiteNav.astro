---
import { SITE_SHORT_NAME } from '../lib/site'

// どのページからも使うので、トップのセクションへのリンクは必ず "/#..." の形にする

/** 現在地。記事まわり (一覧・詳細・カテゴリ・タグ) は ARTICLES、部員紹介は MEMBERS を指す */
const path = Astro.url.pathname
const ARTICLE_PATHS = ['/posts/', '/category/', '/tag/']
const current = ARTICLE_PATHS.some((prefix) => path.startsWith(prefix))
	? 'articles'
	: path.startsWith('/members/')
		? 'members'
		: null
const currentAttr = (key: string) => (current === key ? 'page' : undefined)
---

<header class="site-header">
	<nav class="nav" aria-label="メインメニュー">
		<a class="logo" href="/">
			<svg viewBox="0 0 48 48" aria-hidden="true">
				<circle cx="20" cy="24" r="15" fill="#eafcfc" stroke="#00B4B8" stroke-width="2.2"></circle>
				<circle cx="15" cy="20" r="4.2" fill="none" stroke="#00B4B8" stroke-width="1.6"></circle>
				<circle cx="15" cy="20" r="1.5" fill="#EE82EE"></circle>
				<circle cx="24" cy="28" r="5" fill="none" stroke="#00B4B8" stroke-width="1.6"></circle>
				<circle cx="24" cy="28" r="1.7" fill="#EE82EE"></circle>
				<circle cx="14" cy="30" r="3" fill="none" stroke="#00B4B8" stroke-width="1.6"></circle>
				<path
					d="M33 12 L40 17 M33 12 L40 8 M40 17 L40 8 M40 17 L44 24 M40 8 L44 24"
					stroke="#EE82EE"
					stroke-width="1.6"
					fill="none"
					stroke-linecap="round"
				></path>
				<circle cx="33" cy="12" r="2.6" fill="#EE82EE"></circle>
				<circle cx="40" cy="17" r="2.2" fill="#EE82EE"></circle>
				<circle cx="40" cy="8" r="2.2" fill="#EE82EE"></circle>
				<circle cx="44" cy="24" r="2.2" fill="#EE82EE"></circle>
			</svg>
			{SITE_SHORT_NAME}
		</a>

		<button class="toggle" type="button" aria-expanded="false" aria-controls="site-nav-items">
			<span class="toggle-bars" aria-hidden="true">
				<span></span>
				<span></span>
				<span></span>
			</span>
			<span class="toggle-label">MENU</span>
		</button>

		<div class="items" id="site-nav-items">
			<a class="item tone-teal" href="/#about">
				<svg viewBox="0 0 32 32" aria-hidden="true">
					<path
						d="M5 8.5 a11 11 0 0 1 11 1.6 a11 11 0 0 1 11 -1.6 v14.5 a11 11 0 0 0 -11 1.6 a11 11 0 0 0 -11 -1.6 Z"
						fill="#eafcfc"
						stroke="#00B4B8"
						stroke-width="2"
						stroke-linejoin="round"
					></path>
					<path d="M16 10.1 V25.6" stroke="#00B4B8" stroke-width="2"></path>
					<path
						d="M8.5 13 h4.5 M8.5 17 h4.5"
						stroke="#EE82EE"
						stroke-width="1.8"
						stroke-linecap="round"
					></path>
					<path
						d="M19 13 h4.5 M19 17 h4.5"
						stroke="#EE82EE"
						stroke-width="1.8"
						stroke-linecap="round"
					></path>
				</svg>
				<span>ABOUT</span>
			</a>
			<a class="item tone-violet" href="/#activity">
				<svg viewBox="0 0 32 32" aria-hidden="true">
					<rect
						x="6"
						y="6.5"
						width="20"
						height="14"
						rx="3.2"
						fill="#fdefff"
						stroke="#EE82EE"
						stroke-width="2"
					></rect>
					<path
						d="M3.5 24.5 h25 a2.5 2.5 0 0 1 -2.5 2.5 h-20 a2.5 2.5 0 0 1 -2.5 -2.5 Z"
						fill="#fdefff"
						stroke="#EE82EE"
						stroke-width="2"
						stroke-linejoin="round"
					></path>
					<path
						d="M10.5 15.5 l3 -4 l3 3 l3.5 -5"
						fill="none"
						stroke="#00B4B8"
						stroke-width="2.2"
						stroke-linecap="round"
						stroke-linejoin="round"
					></path>
					<path
						d="M22.5 9.5 l.9 2.1 l2.1 .9 l-2.1 .9 l-.9 2.1 l-.9 -2.1 l-2.1 -.9 l2.1 -.9 Z"
						fill="#00B4B8"
					></path>
				</svg>
				<span>ACTIVITIES</span>
			</a>
			<a class="item tone-teal" href="/posts/" aria-current={currentAttr('articles')}>
				<svg viewBox="0 0 32 32" aria-hidden="true">
					<path
						d="M9 5 H19.5 L26 11.5 V24.5 A2.5 2.5 0 0 1 23.5 27 H9 A2.5 2.5 0 0 1 6.5 24.5 V7.5 A2.5 2.5 0 0 1 9 5 Z"
						fill="#eafcfc"
						stroke="#00B4B8"
						stroke-width="2"
						stroke-linejoin="round"
					></path>
					<path
						d="M19.5 5 V11.5 H26"
						fill="#fff"
						stroke="#00B4B8"
						stroke-width="2"
						stroke-linejoin="round"
					></path>
					<path
						d="M11 13 h4.5 M11 17.5 h10.5 M11 22 h7"
						stroke="#EE82EE"
						stroke-width="1.8"
						stroke-linecap="round"
					></path>
				</svg>
				<span>ARTICLES</span>
			</a>
			<a class="item tone-teal" href="/#research">
				<svg viewBox="0 0 32 32" aria-hidden="true">
					<rect
						x="4.5"
						y="7.5"
						width="17"
						height="17"
						rx="3"
						fill="#eafcfc"
						stroke="#00B4B8"
						stroke-width="2"
					></rect>
					<circle cx="13" cy="16" r="5" fill="#fff" stroke="#00B4B8" stroke-width="1.6"></circle>
					<circle cx="11.6" cy="14.8" r="1.5" fill="#EE82EE"></circle>
					<circle cx="14.6" cy="17.6" r="1.5" fill="#EE82EE"></circle>
					<path
						d="M24 11 L28.5 14 M24 11 L28.5 8 M28.5 14 L28.5 8 M28.5 14 L26.5 20 M28.5 8 L26.5 20"
						stroke="#EE82EE"
						stroke-width="1.5"
						fill="none"
						stroke-linecap="round"
					></path>
					<circle cx="24" cy="11" r="2" fill="#EE82EE"></circle>
					<circle cx="28.5" cy="14" r="1.7" fill="#EE82EE"></circle>
					<circle cx="28.5" cy="8" r="1.7" fill="#EE82EE"></circle>
					<circle cx="26.5" cy="20" r="1.7" fill="#EE82EE"></circle>
				</svg>
				<span>RESEARCH</span>
			</a>
			<a class="item tone-violet" href="/members/" aria-current={currentAttr('members')}>
				<svg viewBox="0 0 32 32" aria-hidden="true">
					<circle cx="11" cy="12" r="4.4" fill="#eafcfc" stroke="#00B4B8" stroke-width="2"></circle>
					<path
						d="M4 26 a7 7 0 0 1 14 0"
						fill="#eafcfc"
						stroke="#00B4B8"
						stroke-width="2"
						stroke-linecap="round"
					></path>
					<circle
						cx="22"
						cy="13.5"
						r="3.6"
						fill="#fdefff"
						stroke="#EE82EE"
						stroke-width="2"
					></circle>
					<path
						d="M16.5 26 a5.8 5.8 0 0 1 11.5 0"
						fill="#fdefff"
						stroke="#EE82EE"
						stroke-width="2"
						stroke-linecap="round"
					></path>
				</svg>
				<span>MEMBERS</span>
			</a>
			<a class="item join" href="/#join">
				<svg viewBox="0 0 32 32" aria-hidden="true">
					<path
						d="M16 27 C9 21.5 4.5 18.5 4.5 13.6 A6.1 6.1 0 0 1 16 10.4 A6.1 6.1 0 0 1 27.5 13.6 C27.5 18.5 23 21.5 16 27 Z"
						fill="rgba(255,255,255,.22)"
						stroke="#fff"
						stroke-width="2"
						stroke-linejoin="round"
					></path>
					<path
						d="M16 15.5 v6 M13 18.5 h6"
						stroke="#fff"
						stroke-width="2.2"
						stroke-linecap="round"
					></path>
				</svg>
				<span>JOIN US</span>
			</a>
		</div>
	</nav>
</header>

<!--
	モバイルのメニュー開閉。読み込み直後に畳むため、モジュールではなくインラインで同期実行する
	（JS が無効なら data-enhanced が付かず、項目は開いたまま表示される）。
-->
<script is:inline>
	;(() => {
		const nav = document.querySelector('.site-header .nav')
		if (!nav) return
		const toggle = nav.querySelector('.toggle')
		const setOpen = (open) => {
			nav.toggleAttribute('data-open', open)
			toggle.setAttribute('aria-expanded', String(open))
		}
		nav.setAttribute('data-enhanced', '')
		toggle.addEventListener('click', () => setOpen(!nav.hasAttribute('data-open')))
		nav.querySelector('.items').addEventListener('click', (e) => {
			if (e.target.closest('a')) setOpen(false)
		})
		document.addEventListener('click', (e) => {
			if (!nav.contains(e.target)) setOpen(false)
		})
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false)
		})
	})()
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		/* ページ遷移のあいだナビを動かさない (styles/tokens.css の ::view-transition-group(site-nav) と対) */
		view-transition-name: site-nav;
		padding: 16px 20px;
		display: flex;
		justify-content: center;
		/* 透明な余白がページのクリックを奪わないようにする */
		pointer-events: none;
	}

	.nav {
		position: relative;
		pointer-events: auto;
		display: flex;
		align-items: center;
		gap: 8px;
		max-width: 100%;
		background: color-mix(in srgb, var(--surface) 86%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: var(--radius-pill);
		padding: 10px 14px 10px 22px;
		box-shadow: var(--shadow-nav);
		line-height: 1.45;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 9px;
		margin-right: 10px;
		font-weight: 900;
		font-size: 30px;
		letter-spacing: 0.02em;
		color: var(--teal-ink);
		white-space: nowrap;
	}

	.logo svg {
		width: 30px;
		height: 30px;
		flex: none;
	}

	.items {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3px;
		padding: 8px 15px 7px;
		border-radius: 24px;
		color: var(--teal-ink);
		transition:
			background 0.2s,
			transform 0.2s;
	}

	.item svg {
		width: 46px;
		height: 46px;
	}

	.item span {
		font-family: var(--font-en);
		font-size: 15px;
		font-weight: 800;
		letter-spacing: 0.1em;
		white-space: nowrap;
	}

	.item.tone-teal:hover {
		background: var(--teal-tint);
		transform: translateY(-2px);
	}

	.item.tone-violet:hover {
		background: var(--violet-tint);
		transform: translateY(-2px);
	}

	/* 現在地。押したときの色を薄く敷いたままにし、文字の下に短い線を引く */
	.item.tone-teal[aria-current='page'] {
		background: var(--teal-tint);
	}

	.item.tone-violet[aria-current='page'] {
		background: var(--violet-tint);
	}

	.item[aria-current='page'] span {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
		text-decoration-color: var(--teal);
	}

	.item.tone-violet[aria-current='page'] span {
		text-decoration-color: var(--violet);
	}

	.item.join {
		padding-inline: 18px;
		margin-left: 4px;
		background: var(--violet);
		color: #fff;
		box-shadow: var(--shadow-violet-sm);
	}

	.item.join:hover {
		background: var(--violet-hover);
		transform: translateY(-2px);
	}

	.toggle {
		display: none;
	}

	/* タブレット幅: 並びは保ったままアイコンと文字を小さくする */
	@media (max-width: 1040px) {
		.nav {
			gap: 4px;
			padding: 8px 10px 8px 18px;
		}

		.logo {
			font-size: 22px;
			margin-right: 4px;
		}

		.logo svg {
			width: 26px;
			height: 26px;
		}

		.items {
			gap: 2px;
		}

		.item {
			padding: 6px 9px 5px;
			border-radius: var(--radius-chip);
		}

		.item svg {
			width: 32px;
			height: 32px;
		}

		.item span {
			font-size: 11px;
		}

		.item.join {
			padding-inline: 12px;
		}
	}

	/* モバイル: ロゴ＋メニューボタンだけの帯にして、項目は畳む */
	@media (max-width: 760px) {
		.site-header {
			padding: 10px 12px;
		}

		.nav {
			width: 100%;
			justify-content: space-between;
			padding: 8px 8px 8px 16px;
		}

		.toggle {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			height: 40px;
			padding: 0 16px 0 14px;
			border: 0;
			border-radius: var(--radius-pill);
			background: var(--teal-tint);
			color: var(--teal-ink);
			font-family: var(--font-en);
			font-size: 12px;
			font-weight: 800;
			letter-spacing: 0.1em;
			cursor: pointer;
		}

		.toggle-bars {
			display: grid;
			gap: 4px;
			width: 18px;
		}

		.toggle-bars span {
			height: 2px;
			border-radius: 2px;
			background: var(--teal);
			transition:
				transform 0.2s,
				opacity 0.2s;
		}

		.nav[data-open] .toggle-bars span:nth-child(1) {
			transform: translateY(6px) rotate(45deg);
		}

		.nav[data-open] .toggle-bars span:nth-child(2) {
			opacity: 0;
		}

		.nav[data-open] .toggle-bars span:nth-child(3) {
			transform: translateY(-6px) rotate(-45deg);
		}

		.items {
			position: absolute;
			top: calc(100% + 8px);
			left: 0;
			right: 0;
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 6px;
			padding: 12px;
			border-radius: var(--radius-card-sm);
			/* 下の文字が透けると項目が読みにくいので、開いたパネルは不透明にする */
			background: var(--surface);
			box-shadow: var(--shadow-nav);
		}

		.nav[data-enhanced]:not([data-open]) .items {
			display: none;
		}

		.item {
			padding: 10px 4px 8px;
		}

		.item svg {
			width: 36px;
			height: 36px;
		}

		.item.join {
			margin-left: 0;
			padding-inline: 4px;
		}

		/* JS が無いときは畳めないので、帯を固定せず項目を下に並べる */
		.nav:not([data-enhanced]) {
			flex-wrap: wrap;
			border-radius: var(--radius-card-sm);
		}

		.nav:not([data-enhanced]) .toggle {
			display: none;
		}

		.nav:not([data-enhanced]) .items {
			position: static;
			width: 100%;
			padding: 4px 0 0;
			background: none;
			box-shadow: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.item,
		.toggle-bars span {
			transition: none;
		}

		.item:hover {
			transform: none;
		}
	}
</style>
