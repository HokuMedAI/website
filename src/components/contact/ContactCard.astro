---
/**
 * 連絡先 1 つぶんのカード。ロゴ・名前・短い説明 (slot) と、そのサービスを別のタブで開くボタン。
 */
import BrandIcon from './BrandIcon.astro'

interface Props {
	icon: 'discord' | 'instagram'
	title: string
	/** ボタンの文字 */
	action: string
	href: string
	tone?: 'teal' | 'violet'
}

const { icon, title, action, href, tone = 'teal' } = Astro.props
---

<li class:list={['card', `tone-${tone}`]}>
	<div class="icon">
		<BrandIcon name={icon} />
	</div>
	<div class="text">
		<h2 lang="en">{title}</h2>
		<p>
			<slot />
		</p>
	</div>
	<a class="button" href={href} target="_blank" rel="noopener noreferrer">
		{action}
	</a>
</li>

<style>
	.card {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 20px 24px;
		border: 5px solid var(--teal-line);
		border-radius: var(--radius-card);
		padding: 30px 32px;
		background: var(--surface);
	}

	.card.tone-violet {
		border-color: var(--violet-line);
	}

	.icon {
		flex: none;
		width: 68px;
		height: 68px;
		border-radius: var(--radius-chip);
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--teal-tint);
		color: var(--teal-strong);
	}

	.tone-violet .icon {
		background: var(--violet-tint);
		color: var(--violet-strong);
	}

	.icon :global(svg) {
		width: 36px;
		height: 36px;
	}

	.text {
		flex: 1 1 15em;
		min-width: 0;
	}

	h2 {
		margin: 0;
		font-family: var(--font-en);
		font-size: 26px;
		font-weight: 800;
		line-height: 1.3;
		letter-spacing: 0.01em;
		color: var(--teal-ink);
	}

	p {
		margin: 6px 0 0;
		font-size: 16px;
		line-height: 1.9;
		color: var(--text-mid);
		text-wrap: pretty;
	}

	.button {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--teal);
		color: #fff;
		font-weight: 700;
		font-size: 17px;
		line-height: 1.45;
		padding: 16px 32px;
		border-radius: var(--radius-pill);
		box-shadow: var(--shadow-sm);
		transition:
			transform 0.2s,
			background 0.2s;
	}

	.button:hover {
		background: var(--teal-strong);
		color: #fff;
		transform: translateY(-2px);
	}

	.tone-violet .button {
		background: var(--violet-strong);
	}

	.tone-violet .button:hover {
		background: var(--violet-mid);
	}

	.button:focus-visible {
		outline: 3px solid var(--violet);
		outline-offset: 3px;
	}

	@media (max-width: 640px) {
		.card {
			padding: 22px 20px 24px;
			border-width: 4px;
			gap: 16px;
		}

		.icon {
			width: 56px;
			height: 56px;
			border-radius: 16px;
		}

		.icon :global(svg) {
			width: 30px;
			height: 30px;
		}

		/* ロゴと名前を横に並べ、説明とボタンは下へ送る */
		.text {
			display: contents;
		}

		h2 {
			flex: 1 1 0;
			font-size: 23px;
		}

		p {
			flex: 1 1 100%;
			margin: 0;
			font-size: 15px;
		}

		.button {
			flex: 1 1 100%;
			font-size: 16px;
			padding: 14px 28px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.button {
			transition: none;
		}

		.button:hover {
			transform: none;
		}
	}
</style>
