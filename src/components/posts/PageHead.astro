---
/**
 * ページの見出し。トップページの各セクションと同じ組み:
 * 番号 ＋ 英字（Outfit 800）＋ その後ろに輪郭だけの大きな英字 ＋ 和文の小見出し（これが h1）。
 * slot には見出しの下に置く説明文を入れる。
 */
interface Props {
	/** 番号の位置に出す短い文字（"01" など） */
	index: string
	/** 英字の見出し */
	en: string
	/** 和文の見出し。h1 になる */
	ja: string
	/** 後ろの輪郭文字。省略時は en */
	ghost?: string
	/** 輪郭文字の色味 */
	tone?: 'teal' | 'violet'
}

const { index, en, ja, ghost = en, tone = 'teal' } = Astro.props
---

<header class:list={['page-head', `page-head--${tone}`]}>
	<span class="page-head__ghost" lang="en" aria-hidden="true">
		{ghost}
	</span>
	<p class="page-head__line">
		<span class="page-head__index">{index}</span>
		<span class="page-head__en" lang="en">
			{en}
		</span>
	</p>
	<h1 class="page-head__ja">{ja}</h1>
	{Astro.slots.has('default') && (
		<div class="page-head__lead">
			<slot />
		</div>
	)}
</header>

<style>
	.page-head {
		position: relative;
		padding-top: 52px;
	}

	.page-head__ghost {
		position: absolute;
		top: 0;
		left: -6px;
		font-family: var(--font-en);
		font-size: clamp(72px, 10vw, 128px);
		font-weight: 800;
		line-height: 0.78;
		letter-spacing: -0.03em;
		white-space: nowrap;
		color: transparent;
		-webkit-text-stroke: 2px var(--teal-ghost);
		pointer-events: none;
		user-select: none;
	}

	.page-head--violet .page-head__ghost {
		-webkit-text-stroke-color: var(--violet-ghost);
	}

	.page-head__line {
		position: relative;
		display: flex;
		align-items: center;
		gap: 14px;
		margin: 0;
	}

	.page-head__index {
		font-family: var(--font-en);
		font-size: 20px;
		font-weight: 800;
		letter-spacing: 0.14em;
		color: var(--violet);
	}

	.page-head__en {
		font-family: var(--font-en);
		font-size: clamp(38px, 4.8vw, 60px);
		font-weight: 800;
		line-height: 1;
		letter-spacing: 0.01em;
		color: var(--teal-ink);
	}

	.page-head__ja {
		position: relative;
		margin: 12px 0 0;
		font-size: 20px;
		font-weight: 700;
		line-height: 1.6;
		letter-spacing: 0.04em;
		color: var(--text-mid);
		overflow-wrap: anywhere;
	}

	.page-head__lead {
		position: relative;
		max-width: 44em;
		margin-top: 18px;
		font-size: 17px;
		line-height: 2.05;
		color: var(--text-mid);
		text-wrap: pretty;
	}

	.page-head__lead :global(p) {
		margin: 0;
	}

	@media (max-width: 640px) {
		.page-head__lead {
			font-size: 16px;
			line-height: 1.95;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.page-head__ghost {
			animation: page-head-ghost 1.1s var(--ease-out) both;
		}

		.page-head__line,
		.page-head__ja,
		.page-head__lead {
			animation: page-head-line 0.8s var(--ease-out) both;
		}

		.page-head__ja {
			animation-delay: 0.08s;
		}

		.page-head__lead {
			animation-delay: 0.16s;
		}
	}

	@keyframes page-head-ghost {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes page-head-line {
		from {
			opacity: 0;
			transform: translateX(-14px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}
</style>
