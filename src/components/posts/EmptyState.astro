---
/**
 * 記事が 0 件のときの表示。slot に本文（1〜2 文）を入れる。
 */
interface Props {
	title: string
	/** 戻り先のリンク。省略すると出さない */
	action?: { label: string; href: string }
}

const { title, action } = Astro.props
---

<div class="empty">
	<svg class="empty__mark" viewBox="0 0 96 96" aria-hidden="true">
		<rect x="14" y="20" width="58" height="62" rx="16" class="empty__paper"></rect>
		<path d="M28 40h30M28 52h30M28 64h18" class="empty__rule"></path>
		<circle cx="72" cy="26" r="15" class="empty__dot"></circle>
		<path d="M72 19v14M65 26h14" class="empty__plus"></path>
	</svg>
	<p class="empty__title">{title}</p>
	<div class="empty__text">
		<slot />
	</div>
	{action && (
		<a class="empty__action" href={action.href}>
			{action.label}
		</a>
	)}
</div>

<style>
	.empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 56px 28px 60px;
		border-radius: var(--radius-panel);
		background: var(--teal-tint);
		text-align: center;
	}

	.empty__mark {
		width: 88px;
		height: 88px;
	}

	.empty__paper {
		fill: var(--surface);
		stroke: var(--teal);
		stroke-width: 4;
	}

	.empty__rule {
		fill: none;
		stroke: var(--teal-line);
		stroke-width: 5;
		stroke-linecap: round;
	}

	.empty__dot {
		fill: var(--violet);
	}

	.empty__plus {
		fill: none;
		stroke: #fff;
		stroke-width: 4;
		stroke-linecap: round;
	}

	.empty__title {
		margin: 20px 0 0;
		font-size: 21px;
		font-weight: 900;
		line-height: 1.5;
		color: var(--teal-ink);
	}

	.empty__text {
		max-width: 30em;
		margin-top: 8px;
		font-size: 15px;
		line-height: 2;
		color: var(--text-soft);
		text-wrap: pretty;
	}

	.empty__text :global(p) {
		margin: 0;
	}

	.empty__action {
		display: inline-flex;
		align-items: center;
		margin-top: 24px;
		padding: 13px 28px;
		border-radius: var(--radius-pill);
		background: var(--teal-ink);
		color: #fff;
		font-size: 15px;
		font-weight: 700;
		line-height: 1.4;
		transition:
			background 0.2s,
			transform 0.2s var(--ease-out);
	}

	.empty__action:hover {
		background: var(--teal-strong);
		color: #fff;
		transform: translateY(-2px);
	}

	.empty__action:focus-visible {
		outline: 3px solid var(--violet);
		outline-offset: 3px;
	}

	@media (max-width: 600px) {
		.empty {
			padding: 40px 20px 44px;
			border-radius: 32px;
		}

		.empty__title {
			font-size: 19px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.empty__action {
			transition: none;
		}

		.empty__action:hover {
			transform: none;
		}
	}
</style>
