---
import { Image } from 'astro:assets'
import Calendar from './Calendar.astro'
import SectionHead from './SectionHead.astro'
import photo1 from '../../assets/landing/photo-1.jpg'
import photo2 from '../../assets/landing/photo-2.webp'
import photo3 from '../../assets/landing/photo-3.webp'
import scienceCafe from '../../assets/landing/science-cafe.jpg'

interface Props {
	num: string
}

const { num } = Astro.props

const photos = [
	{ src: photo1, alt: '勉強会の様子。スクリーンを囲んで作業する部員たち' },
	{ src: photo2, alt: '活動中のテーブル。紙コップのお茶とピザ' },
	{ src: photo3, alt: '活動の合間の部員たち' },
]
---

<section id="activity" class="activity">
	<div class="inner">
		<SectionHead num={num} en="Activities" ja="活動内容" ghost="violet" />

		<p class="intro">ふだんは週1回の勉強会が中心。参加は自由参加です。</p>

		<div class="cards">
			<article class="card tone-teal">
				<div class="card-num">01</div>
				<h3>
					勉強会 <span class="when">◇毎週水曜日 16:30〜18:00</span>
				</h3>
				<p>
					途中で質問や相談をしながら、互いに刺激を受けつつ各々の課題に取り組んでいます。先輩が分からないところを教えてくれます。
				</p>
			</article>
			<article class="card tone-violet">
				<div class="card-num">02</div>
				<h3>
					全体ミーティング <span class="when">◇第2水曜日 18:00〜</span>
				</h3>
				<p>勉強会のあとに、部員みんなで集まるミーティングです。</p>
			</article>
			<article class="card tone-teal">
				<div class="card-num">03</div>
				<h3>
					定期レクチャー <span class="when">◇第4水曜日 18:00〜</span>
				</h3>
				<p>AIの基礎知識や医療AIの最新研究を持ち回りでレクチャーします。</p>
			</article>
			<article class="card tone-violet">
				<div class="card-num">04</div>
				<h3>他大学との交流</h3>
				<p>
					他大学の医療AI団体との合同勉強会を開催することも。
					<strong>2026年は九州大学医学部情報研究会とオンラインで交流しました！</strong>
				</p>
			</article>

			<!-- 写真のマーキー。同じ並びを 2 回描き、1 組ぶん（-50%）流して継ぎ目なく繰り返す -->
			<div class="marquee">
				<div class="track">
					{[0, 1].map((copy) => (
						<div class="set" aria-hidden={copy === 1 ? 'true' : undefined}>
							{photos.map((p) => (
								<div class="shot">
									<Image
										src={p.src}
										alt={copy === 0 ? p.alt : ''}
										widths={[540, p.src.width]}
										sizes="(max-width: 640px) 78vw, 540px"
										loading="lazy"
									/>
								</div>
							))}
						</div>
					))}
				</div>
			</div>
		</div>

		<Calendar />

		<div class="column">
			<div class="column-photo">
				<Image
					src={scienceCafe}
					alt="サイエンスカフェのテーブルに並んだお菓子とお茶"
					widths={[440, scienceCafe.width]}
					sizes="(max-width: 640px) 90vw, 440px"
					loading="lazy"
				/>
			</div>
			<div>
				<div class="column-tags">
					<span class="column-badge">COLUMN</span>
					<span class="column-kicker">活動場所のこと</span>
				</div>
				<h3>
					コーヒー片手に、AIを。
					<br />
					「サイエンスカフェ」で活動しています
				</h3>
				<p>
					北海道大学大学院医学研究院2階の「サイエンスカフェ」は、2026年6月に新しくできた、
					<strong>木のぬくもりを感じる暖かみのある空間</strong>です。研究会のメンバーは
					<strong>コーヒーやお茶を片手に</strong>、リラックスした雰囲気で活動に取り組んでいます。
				</p>
				<div class="column-chips">
					<span class="tone-teal">医学研究院 2F</span>
					<span class="tone-violet">2026.6.29 オープン</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.activity {
		position: relative;
		margin-top: -1px;
		background: var(--teal-tint);
		border: 5px solid var(--teal);
		/* 下は必ず別のセクションが重なるので、枠線は上と左右だけ */
		border-bottom: 0;
		border-radius: var(--radius-section) var(--radius-section) 0 0;
		padding: 84px var(--gutter) 96px;
		overflow-x: clip;
	}

	.inner {
		max-width: var(--content-width);
		margin: 0 auto;
	}

	.intro {
		margin: 18px 0 0;
		max-width: 44em;
		font-size: 19px;
		line-height: 2.1;
		color: var(--text-mid);
	}

	.cards {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		margin-top: 40px;
	}

	.card {
		flex: 1 1 300px;
		min-width: 0;
		border: 5px solid var(--teal-line);
		border-radius: var(--radius-card);
		padding: 34px 26px;
		background: var(--surface);
		transition:
			border-color 0.2s,
			transform 0.2s;
	}

	.card.tone-violet {
		border-color: var(--violet-line);
	}

	.card.tone-teal:hover {
		border-color: var(--teal);
		transform: translateY(-3px);
	}

	.card.tone-violet:hover {
		border-color: var(--violet);
		transform: translateY(-3px);
	}

	.card-num {
		width: 52px;
		height: 52px;
		border-radius: var(--radius-chip);
		background: var(--teal);
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-en);
		font-weight: 800;
		font-size: 25px;
		line-height: 1;
	}

	.tone-violet .card-num {
		background: var(--violet);
	}

	.card h3 {
		margin: 12px 0 0;
		font-size: 25px;
		font-weight: 900;
		line-height: 1.45;
		color: var(--teal-ink);
	}

	/* 開催日。見出しの 2 行目に送る */
	.when {
		display: block;
		font-size: 0.8em;
		color: var(--teal-strong);
	}

	.tone-violet .when {
		color: var(--violet-strong);
	}

	.card p {
		margin: 12px 0 0;
		font-size: 16px;
		line-height: 2;
		color: var(--text-soft);
	}

	.card strong,
	.column strong {
		color: var(--violet-strong);
		font-weight: 700;
	}

	.marquee {
		flex: 2 1 620px;
		min-width: 0;
		display: flex;
		align-items: center;
		overflow: hidden;
		border-radius: var(--radius-card-lg);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
		--shot-w: 540px;
		--shot-gap: 20px;
	}

	.track {
		display: flex;
		width: max-content;
		animation: activity-marquee 40s linear infinite;
	}

	.set {
		display: flex;
		gap: var(--shot-gap);
		padding-right: var(--shot-gap);
	}

	.shot {
		flex: none;
		width: var(--shot-w);
		aspect-ratio: 27 / 16;
		border-radius: var(--radius-card-md);
		overflow: hidden;
		background: var(--surface);
	}

	.shot :global(img),
	.column-photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		object-fit: cover;
	}

	@keyframes activity-marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	.column {
		margin-top: 34px;
		background: var(--surface);
		border-radius: var(--radius-card-lg);
		padding: 36px;
		display: grid;
		grid-template-columns: minmax(0, 438fr) minmax(0, 518fr);
		gap: 32px 48px;
		align-items: center;
		box-shadow: var(--shadow-md);
	}

	.column-photo {
		aspect-ratio: 438 / 315;
		border-radius: var(--radius-leaf-sm);
		overflow: hidden;
		background: var(--violet-tint);
	}

	.column-tags {
		display: flex;
		align-items: center;
		gap: 10px;
		flex-wrap: wrap;
	}

	.column-badge {
		background: var(--violet);
		color: #fff;
		font-family: var(--font-en);
		font-size: 13px;
		font-weight: 800;
		line-height: 1.45;
		letter-spacing: 0.14em;
		padding: 7px 14px;
		border-radius: var(--radius-pill);
	}

	.column-kicker {
		font-size: 14px;
		font-weight: 700;
		color: var(--teal-strong);
	}

	.column h3 {
		margin: 16px 0 0;
		font-size: 26px;
		font-weight: 900;
		line-height: 1.45;
		color: var(--teal-ink);
		text-wrap: pretty;
	}

	.column p {
		margin: 14px 0 0;
		font-size: 16px;
		line-height: 2;
		color: var(--text-mid);
		text-wrap: pretty;
	}

	.column-chips {
		margin-top: 18px;
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	.column-chips span {
		color: var(--teal-ink);
		font-weight: 700;
		font-size: 14px;
		line-height: 1.45;
		padding: 9px 16px;
		border-radius: var(--radius-pill);
		background: var(--teal-tint);
	}

	.column-chips .tone-violet {
		background: var(--violet-tint);
	}

	@media (max-width: 820px) {
		.column {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.activity {
			padding: 60px var(--gutter) 72px;
			border-width: 4px;
			border-bottom: 0;
		}

		.intro {
			font-size: 16px;
			line-height: 2;
		}

		.cards {
			gap: 16px;
			margin-top: 30px;
		}

		.card {
			flex-basis: 100%;
			padding: 24px 22px 26px;
			border-width: 4px;
		}

		.card-num {
			width: 46px;
			height: 46px;
			font-size: 21px;
			border-radius: 16px;
		}

		.card h3 {
			font-size: 21px;
		}

		.card p {
			font-size: 15px;
			line-height: 1.95;
		}

		.marquee {
			flex-basis: 100%;
			border-radius: var(--radius-card);
			--shot-w: 78vw;
			--shot-gap: 12px;
		}

		.shot {
			border-radius: 24px;
		}

		.column {
			margin-top: 22px;
			padding: 18px 18px 26px;
			border-radius: var(--radius-card);
			gap: 22px;
		}

		.column-photo {
			border-radius: 72px 24px 72px 24px;
		}

		.column h3 {
			font-size: 20px;
		}

		.column p {
			font-size: 15px;
			line-height: 1.95;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track {
			animation: none;
		}

		/* 流れない代わりに、手で横に送れるようにする */
		.marquee {
			overflow-x: auto;
		}

		.card {
			transition: none;
		}

		.card:hover {
			transform: none;
		}
	}
</style>
