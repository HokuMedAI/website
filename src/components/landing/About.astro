---
import SectionHead from './SectionHead.astro'
import { PRISM_HU_URL, SITE_NAME, SITE_SHORT_NAME } from '../../lib/site'

interface Stat {
	value: number
	unit: string
	label: string
	note: string
	/** くわしいページ・セクションへのリンク。カード全体が押せるようになる */
	link: { href: string; label: string }
}

interface Props {
	num: string
	/** src/content/ から数えた値。0 件の項目は呼び出し側で外す */
	stats: Stat[]
}

const { num, stats } = Astro.props
---

<section id="about" class="about">
	<div class="inner">
		<SectionHead num={num} en="About" ja="研究会について" />

		<p class="intro">
			いつの間にか、AIは日常の風景になりました。その波は、医療分野にも確かに届いています。
			<br />
			<strong>
				画像・検査値・カルテ・ゲノム。医療の現場はまだ読み解かれていないデータであふれています。
			</strong>
			<br />
			{SITE_SHORT_NAME}
			は、北海道大学医学部の学生を中心に、AI（人工知能）の医療応用について学び、研究する場所です。教える人/教わる人がときに入れ替わりながら活動しています。
		</p>

		<div class="us">
			<h3>私たちについて</h3>
			<p>
				{SITE_NAME}は学生団体です。北海道大学 大学院医学研究院 連携研究センター 医学研究AI支援部門 /{' '}
				<a href={PRISM_HU_URL} target="_blank" rel="noopener noreferrer">
					PRISM-HU
				</a>{' '}
				の支援のもとで活動しています。
			</p>
			<p>
				医学部の学生が、学生のうちから高度な研究に関わることで、AIを使いこなせる人材を輩出する。そのために発足しました。
			</p>
			<p>
				将来医師になる医学生が、主体的にAIを学び、使いこなす。AIを理解するには、ITだけでなく、統計や数学といった情報科学も必要です。私たちはそうした深い理解から取り組み、その過程で学生同士が切磋琢磨しています。
			</p>
		</div>

		{stats.length > 0 && (
			<div class="stats">
				{stats.map((s) => (
					<a class="stat" href={s.link.href}>
						<div class="stat-value">
							{s.value}
							<span>{s.unit}</span>
						</div>
						<div class="stat-label">{s.label}</div>
						<p>{s.note}</p>
						<div class="stat-more">{s.link.label} →</div>
					</a>
				))}
			</div>
		)}

		<div class="chips">
			<span class="chip solid">2023年 設立</span>
			<span class="chip">活動場所：北大医学研究院2階「サイエンスカフェ」</span>
			<span class="chip">兼サークル歓迎</span>
		</div>
	</div>
</section>

<style>
	.about {
		position: relative;
		background: var(--surface);
		border-radius: var(--radius-section) var(--radius-section) 0 0;
		padding: 84px var(--gutter) 90px;
		overflow-x: clip;
	}

	.inner {
		max-width: var(--content-width);
		margin: 0 auto;
	}

	.intro {
		margin: 20px 0 0;
		max-width: 44em;
		font-size: 19px;
		line-height: 2.1;
		color: var(--text-mid);
		text-wrap: pretty;
	}

	.intro strong {
		color: var(--violet-strong);
		font-weight: 700;
	}

	.us {
		margin-top: 40px;
		border: 5px solid var(--teal-line);
		border-radius: var(--radius-card);
		padding: 34px 36px 36px;
		background: var(--surface);
	}

	.us h3 {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0;
		font-size: 24px;
		font-weight: 900;
		line-height: 1.45;
		color: var(--teal-ink);
	}

	.us h3::before {
		content: '';
		flex: none;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--violet);
	}

	.us p {
		margin: 14px 0 0;
		font-size: 17px;
		line-height: 2;
		color: var(--text-mid);
		text-wrap: pretty;
	}

	.us a {
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 20px;
		margin-top: 44px;
	}

	.stat {
		display: flex;
		flex-direction: column;
		background: var(--teal-tint);
		border-radius: var(--radius-card-md);
		padding: 30px 28px 26px;
		color: inherit;
		transition:
			transform 0.2s,
			box-shadow 0.2s;
	}

	.stat:nth-child(even) {
		background: var(--violet-tint);
	}

	.stat:hover {
		color: inherit;
		transform: translateY(-3px);
		box-shadow: var(--shadow-sm);
	}

	.stat:focus-visible {
		outline: 3px solid var(--violet);
		outline-offset: 3px;
	}

	.stat-value {
		font-family: var(--font-en);
		font-size: 44px;
		font-weight: 800;
		line-height: 1;
		color: var(--teal);
	}

	.stat:nth-child(even) .stat-value {
		color: var(--violet-mid);
	}

	.stat-value span {
		margin-left: 4px;
		font-family: var(--font-jp);
		font-size: 20px;
		font-weight: 900;
	}

	.stat-label {
		margin-top: 10px;
		font-weight: 700;
		line-height: 1.45;
		color: var(--teal-ink);
	}

	.stat p {
		margin: 8px 0 0;
		font-size: 14px;
		line-height: 1.9;
		color: var(--text-soft);
		/* 「学外 1件」のような語の途中で折り返さない（対応ブラウザのみ） */
		word-break: auto-phrase;
		text-wrap: pretty;
	}

	/* カードの高さが揃っても、リンクの文字は下端に揃える */
	.stat-more {
		margin-top: auto;
		padding-top: 14px;
		font-size: 14px;
		font-weight: 700;
		line-height: 1.45;
		color: var(--teal-strong);
	}

	.stat:nth-child(even) .stat-more {
		color: var(--violet-strong);
	}

	.chips {
		margin-top: 24px;
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	.chip {
		background: var(--teal-tint);
		color: var(--teal-ink);
		font-weight: 700;
		font-size: 17px;
		line-height: 1.45;
		padding: 12px 22px;
		border-radius: var(--radius-pill);
	}

	.chip.solid {
		background: var(--teal);
		color: #fff;
	}

	@media (max-width: 640px) {
		.about {
			padding: 60px var(--gutter) 64px;
		}

		.intro {
			font-size: 16px;
			line-height: 2;
		}

		.us {
			margin-top: 32px;
			padding: 24px 20px 26px;
		}

		.us h3 {
			font-size: 20px;
		}

		.us p {
			font-size: 15px;
			line-height: 1.95;
		}

		.stats {
			grid-template-columns: 1fr;
			gap: 14px;
			margin-top: 32px;
		}

		.stat {
			padding: 24px 22px 22px;
			border-radius: var(--radius-card);
		}

		.chip {
			font-size: 14px;
			padding: 10px 16px;
			border-radius: 22px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.stat {
			transition: none;
		}

		.stat:hover {
			transform: none;
		}
	}
</style>
