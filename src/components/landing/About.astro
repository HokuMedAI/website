---
import { Image } from 'astro:assets'
import SectionHead from './SectionHead.astro'
import emblem from '../../assets/landing/emblem.jpg'
import { PRISM_HU_URL, SITE_SHORT_NAME } from '../../lib/site'

interface Stat {
	value: number
	unit: string
	label: string
	note: string
	/** くわしいページ・セクションへのリンク。カード全体が押せるようになる */
	link: { href: string; label: string }
}

interface Props {
	num: string
	/** src/content/ から数えた値。0 件の項目は呼び出し側で外す */
	stats: Stat[]
}

const { num, stats } = Astro.props

/** 研究会のアイコンを出す幅。高精細な画面用に 2 倍も用意する */
const EMBLEM_WIDTH = 168
---

<section id="about" class="about">
	<div class="inner">
		<SectionHead num={num} en="About" ja="研究会について" />

		<div class="lead">
			<div>
				<p class="intro">
					いつの間にか、AIは日常の風景になりました。その波は、医療分野にも確かに届いています。
					<br />
					<strong>
						画像・検査値・カルテ・ゲノム。医療の現場はまだ読み解かれていないデータであふれています。
					</strong>
					<br />
					{SITE_SHORT_NAME}
					は、北海道大学医学部の学生を中心に、AI（人工知能）の医療応用について学び、研究する場所です。教える人/教わる人がときに入れ替わりながら活動しています。
				</p>
				<p class="support">
					北海道大学大学院 医学研究院 連携研究センター 医学研究AI支援部門（
					<a href={PRISM_HU_URL} target="_blank" rel="noopener noreferrer">
						PRISM-HU
					</a>
					）の支援のもとで活動しています。
				</p>
			</div>
			<Image
				class="emblem"
				src={emblem}
				alt={`${SITE_SHORT_NAME}のアイコン`}
				width={EMBLEM_WIDTH * 2}
				widths={[EMBLEM_WIDTH, EMBLEM_WIDTH * 2]}
				sizes={`(max-width: 640px) 112px, ${EMBLEM_WIDTH}px`}
				loading="lazy"
			/>
		</div>

		{stats.length > 0 && (
			<div class="stats">
				{stats.map((s) => (
					<a class="stat" href={s.link.href}>
						<div class="stat-value">
							{s.value}
							<span>{s.unit}</span>
						</div>
						<div class="stat-label">{s.label}</div>
						<p>{s.note}</p>
						<div class="stat-more">{s.link.label} →</div>
					</a>
				))}
			</div>
		)}

		<div class="chips">
			<span class="chip solid">2023年 設立</span>
			<span class="chip">活動場所：北大医学研究院2階「サイエンスカフェ」</span>
			<span class="chip">兼サークル歓迎</span>
		</div>
	</div>
</section>

<style>
	.about {
		position: relative;
		background: var(--surface);
		border-radius: var(--radius-section) var(--radius-section) 0 0;
		padding: 84px var(--gutter) 90px;
		overflow-x: clip;
	}

	.inner {
		max-width: var(--content-width);
		margin: 0 auto;
	}

	/* 導入文と、その右に研究会のアイコン */
	.lead {
		margin-top: 20px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 28px 36px;
	}

	.intro {
		margin: 0;
		max-width: 44em;
		font-size: 19px;
		line-height: 2.1;
		color: var(--text-mid);
		text-wrap: pretty;
	}

	.intro strong {
		color: var(--violet-strong);
		font-weight: 700;
	}

	.support {
		margin: 18px 0 0;
		font-size: 15px;
		line-height: 2;
		color: var(--text-soft);
		text-wrap: pretty;
	}

	.support a {
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* 研究会のアイコン。貼ったシールのように少し傾ける */
	.emblem {
		flex: none;
		width: 168px;
		height: auto;
		margin-right: 8px;
		border: 3px solid var(--teal-ink);
		border-radius: var(--radius-card-sm);
		box-shadow: var(--shadow-hard-violet-sm);
		transform: rotate(4deg);
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 20px;
		margin-top: 44px;
	}

	.stat {
		display: flex;
		flex-direction: column;
		background: var(--teal-tint);
		border-radius: var(--radius-card-md);
		padding: 30px 28px 26px;
		color: inherit;
		transition:
			transform 0.2s,
			box-shadow 0.2s;
	}

	.stat:nth-child(even) {
		background: var(--violet-tint);
	}

	.stat:hover {
		color: inherit;
		transform: translateY(-3px);
		box-shadow: var(--shadow-sm);
	}

	.stat:focus-visible {
		outline: 3px solid var(--violet);
		outline-offset: 3px;
	}

	.stat-value {
		font-family: var(--font-en);
		font-size: 44px;
		font-weight: 800;
		line-height: 1;
		color: var(--teal);
	}

	.stat:nth-child(even) .stat-value {
		color: var(--violet-mid);
	}

	.stat-value span {
		margin-left: 4px;
		font-family: var(--font-jp);
		font-size: 20px;
		font-weight: 900;
	}

	.stat-label {
		margin-top: 10px;
		font-weight: 700;
		line-height: 1.45;
		color: var(--teal-ink);
	}

	.stat p {
		margin: 8px 0 0;
		font-size: 14px;
		line-height: 1.9;
		color: var(--text-soft);
		/* 「学外 1件」のような語の途中で折り返さない（対応ブラウザのみ） */
		word-break: auto-phrase;
		text-wrap: pretty;
	}

	/* カードの高さが揃っても、リンクの文字は下端に揃える */
	.stat-more {
		margin-top: auto;
		padding-top: 14px;
		font-size: 14px;
		font-weight: 700;
		line-height: 1.45;
		color: var(--teal-strong);
	}

	.stat:nth-child(even) .stat-more {
		color: var(--violet-strong);
	}

	.chips {
		margin-top: 24px;
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	.chip {
		background: var(--teal-tint);
		color: var(--teal-ink);
		font-weight: 700;
		font-size: 17px;
		line-height: 1.45;
		padding: 12px 22px;
		border-radius: var(--radius-pill);
	}

	.chip.solid {
		background: var(--teal);
		color: #fff;
	}

	@media (max-width: 640px) {
		.about {
			padding: 60px var(--gutter) 64px;
		}

		.lead {
			flex-direction: column;
			align-items: flex-start;
		}

		.intro {
			font-size: 16px;
			line-height: 2;
		}

		.support {
			margin-top: 14px;
			font-size: 14px;
			line-height: 1.95;
		}

		.emblem {
			width: 112px;
			margin: 0 0 0 6px;
			border-radius: var(--radius-chip);
		}

		.stats {
			grid-template-columns: 1fr;
			gap: 14px;
			margin-top: 32px;
		}

		.stat {
			padding: 24px 22px 22px;
			border-radius: var(--radius-card);
		}

		.chip {
			font-size: 14px;
			padding: 10px 16px;
			border-radius: 22px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.stat {
			transition: none;
		}

		.stat:hover {
			transform: none;
		}
	}
</style>
