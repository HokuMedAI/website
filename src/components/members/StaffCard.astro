---
/**
 * 顧問・メンターのカード。区分・名前・所属と、あれば丸い写真とコメントの吹き出し。
 * 記事を書いている人は、カードのどこを押しても、その人の記事一覧へ行く。
 * 記事の署名から来たとき (/members/#<名前>) は、そのカードを目立たせる。
 */
import { Image } from 'astro:assets'
import { render, type CollectionEntry } from 'astro:content'
import Comment from './Comment.astro'

interface Props {
	member: CollectionEntry<'members'>
	tone: 'teal' | 'violet'
	/** その人の記事一覧の URL と本数 (署名が紐づいている人だけ) */
	posts?: { href: string; count: number }
}

const { member, tone, posts } = Astro.props
const { name, group, affiliation, photo } = member.data

/** 写真の枠は 84px。高精細な画面用に 2 倍の幅で出す */
const PHOTO_WIDTH = 168

const hasComment = Boolean(member.body?.trim())
const { Content } = hasComment ? await render(member) : { Content: null }
---

<li id={member.id} class:list={['staff-card', `tone-${tone}`]}>
	<div class="staff-main">
		{photo && (
			<div class="staff-photo">
				<Image src={photo} alt={name} width={PHOTO_WIDTH} loading="lazy" />
			</div>
		)}
		<div class="staff-info">
			<span class="staff-group">{group}</span>
			<div class="staff-name">{name}</div>
			{affiliation && <p class="staff-affil">{affiliation}</p>}
		</div>
	</div>
	{Content && (
		<Comment>
			<Content />
		</Comment>
	)}
	{posts && posts.count > 0 && (
		<a class="staff-posts" href={posts.href}>
			記事 {posts.count}本<span aria-hidden="true">→</span>
		</a>
	)}
</li>

<style>
	.staff-card {
		--card-shadow: var(--shadow-hard-teal);
		position: relative;
		scroll-margin-top: 130px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background: var(--surface);
		border: 3px solid var(--teal-ink);
		border-radius: var(--radius-card-sm);
		padding: 22px 26px;
		box-shadow: var(--card-shadow);
	}

	.staff-card.tone-violet {
		--card-shadow: var(--shadow-hard-violet);
	}

	/* 記事の署名から来たとき: 蛍光ペンで囲んだように縁取る */
	.staff-card:target {
		box-shadow:
			0 0 0 8px var(--highlight),
			var(--card-shadow);
	}

	.staff-main {
		display: flex;
		align-items: center;
		gap: 18px;
	}

	.staff-photo {
		flex: none;
		width: 84px;
		height: 84px;
		border-radius: 50%;
		overflow: hidden;
		border: 3px solid var(--teal-ink);
		background: var(--dot-teal-bg);
	}

	.staff-photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		object-fit: cover;
	}

	.staff-info {
		min-width: 0;
	}

	.staff-group {
		display: inline-block;
		background: var(--teal-ink);
		color: #fff;
		font-size: 12px;
		font-weight: 900;
		line-height: 1.45;
		letter-spacing: 0.12em;
		padding: 4px 12px;
		border-radius: var(--radius-pill);
	}

	.staff-name {
		margin-top: 8px;
		font-size: 24px;
		font-weight: 900;
		line-height: 1.4;
		letter-spacing: 0.04em;
		color: var(--teal-ink);
	}

	.staff-affil {
		margin: 6px 0 0;
		font-size: 14px;
		line-height: 1.8;
		color: var(--text-mid);
		text-wrap: pretty;
	}

	/* その人の記事一覧へのリンク。カード全体を押せる範囲にする */
	.staff-posts {
		display: inline-flex;
		align-self: flex-start;
		gap: 0.3em;
		margin-top: 12px;
		padding: 3px 12px;
		border-radius: var(--radius-pill);
		background: var(--teal-tint);
		color: var(--teal-strong);
		font-size: 13px;
		font-weight: 900;
		line-height: 1.6;
	}

	.staff-posts::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.staff-posts:focus-visible {
		outline: 3px solid var(--violet);
		outline-offset: 3px;
	}

	@media (max-width: 640px) {
		.staff-card {
			padding: 18px 20px;
			border-radius: 22px;
			--card-shadow: var(--shadow-hard-teal-sm);
		}

		.staff-card.tone-violet {
			--card-shadow: var(--shadow-hard-violet-sm);
		}

		.staff-name {
			font-size: 21px;
		}

		.staff-affil {
			font-size: 13px;
		}
	}
</style>
