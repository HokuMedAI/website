---
import { Icon } from 'astro-icon/components'
import {
	GITHUB_URL,
	INSTAGRAM_URL,
	RELATED_LINKS,
	SITE_NAME,
	SITE_NAME_EN,
	X_ACCOUNT,
} from '../lib/site'

const year = new Date().getFullYear()

// 外部へのリンク。SNS → GitHub → 関連先の順。Instagram は URL が入るまで出さない。
// icon は各サービスのロゴ (simple-icons のアイコン名)
const externalLinks: { label: string; href: string; icon?: string }[] = [
	{ label: 'X', href: `https://x.com/${X_ACCOUNT}`, icon: 'x' },
	...(INSTAGRAM_URL ? [{ label: 'Instagram', href: INSTAGRAM_URL, icon: 'instagram' }] : []),
	{ label: 'GitHub', href: GITHUB_URL, icon: 'github' },
	...RELATED_LINKS,
]
---

<footer class="site-footer">
	<div class="inner">
		<div class="name">{SITE_NAME}</div>
		<nav class="links" aria-label="フッターメニュー">
			<a href="/#about">研究会について</a>
			<a href="/#activity">活動内容</a>
			<a href="/#schedule">定期の活動</a>
			<a href="/posts/">記事</a>
			<a href="/#research">研究内容</a>
			<a href="/members/">メンバー紹介</a>
			<a href="/contact/">お問い合わせ</a>
		</nav>
		<nav class="external" aria-label="リンク">
			<span class="external-label">リンク</span>
			{externalLinks.map((link) => (
				<a href={link.href} target="_blank" rel="noopener noreferrer">
					{link.icon && <Icon name={`simple-icons:${link.icon}`} aria-hidden="true" />}
					{link.label}
				</a>
			))}
		</nav>
		<div class="copyright">
			© {year} {SITE_NAME_EN}
		</div>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		background: var(--surface);
		border-radius: var(--radius-section) var(--radius-section) 0 0;
		padding: 34px var(--gutter) 46px;
		text-align: center;
		line-height: 1.5;
	}

	.inner {
		max-width: var(--content-width);
		margin: 0 auto;
		border-top: 2px solid var(--teal-tint);
		padding-top: 30px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px 20px;
		flex-wrap: wrap;
	}

	.name {
		font-weight: 900;
		font-size: 16px;
		color: var(--teal-ink);
	}

	.links {
		display: flex;
		gap: 10px 20px;
		flex-wrap: wrap;
		font-size: 14px;
		font-weight: 700;
	}

	/* 外部へのリンクは、団体名とメニューの次の行に並べる */
	.external {
		width: 100%;
		display: flex;
		align-items: center;
		gap: 8px 10px;
		flex-wrap: wrap;
		font-size: 13px;
		font-weight: 700;
	}

	.external-label {
		margin-right: 6px;
		font-family: var(--font-en);
		font-weight: 900;
		letter-spacing: 0.08em;
		color: var(--teal-strong);
	}

	.external a {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 5px 14px;
		border-radius: var(--radius-pill);
		background: var(--teal-tint);
		color: var(--teal-ink);
		transition: background 0.2s;
	}

	.external a :global(svg) {
		width: 14px;
		height: 14px;
		flex: none;
	}

	.external a:hover {
		background: var(--teal-line);
		color: var(--teal-ink);
	}

	/* 団体名とリンクで 1 行を使うので、著作権表示は次の行へ送る */
	.copyright {
		width: 100%;
		text-align: left;
		font-size: 13px;
		color: var(--text-faint);
	}

	@media (max-width: 640px) {
		.inner {
			flex-direction: column;
			gap: 16px;
		}

		.links,
		.external {
			justify-content: center;
		}

		.external-label {
			width: 100%;
			margin-right: 0;
			text-align: center;
		}

		.copyright {
			text-align: center;
		}
	}
</style>
