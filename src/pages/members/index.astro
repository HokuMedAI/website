---
/**
 * 部員紹介。雑誌の 1 ページに見立てた紙面に、部員 (学年の高い順) と顧問・メンターを並べる。
 * 中身は src/content/members/ の 1 人 1 ファイル。
 */
import { getCollection, type CollectionEntry } from 'astro:content'
import Base from '../../layouts/Base.astro'
import SectionHead from '../../components/landing/SectionHead.astro'
import Banner from '../../components/members/Banner.astro'
import Crumbs from '../../components/members/Crumbs.astro'
import MemberCard from '../../components/members/MemberCard.astro'
import Paper from '../../components/members/Paper.astro'
import StaffCard from '../../components/members/StaffCard.astro'
import { fiscalYear, gradeOf } from '../../lib/members'
import { FOUNDED_FISCAL_YEAR, MEMBER_GROUPS, SITE_NAME, SITE_SHORT_NAME } from '../../lib/site'

type Member = CollectionEntry<'members'>

const members = await getCollection('members')

const year = fiscalYear()
/** 設立年度を VOL.01 とした号数 */
const volume = String(year - FOUNDED_FISCAL_YEAR + 1).padStart(2, '0')

// order の小さい順。同じなら id 順にして、ビルドのたびに並びが変わらないようにする
const byOrder = (a: Member, b: Member) => a.data.order - b.data.order || a.id.localeCompare(b.id)

// 部員: 学年の高い順 → order 順。入学年度が無い人は最後
const students = members
	.filter((m) => m.data.group === '部員')
	.map((m) => ({ member: m, grade: gradeOf(m.data.entryYear) }))
	.sort((a, b) => (b.grade ?? 0) - (a.grade ?? 0) || byOrder(a.member, b.member))

// 学年ごとに色を替えて、同じ学年がひとかたまりに見えるようにする
const grades = [...new Set(students.map((s) => s.grade))]
const toneOf = (grade: number | null) => (grades.indexOf(grade) % 2 === 0 ? 'teal' : 'violet')

// 顧問 → メンターの順
const staff = members
	.filter((m) => m.data.group !== '部員')
	.sort(
		(a, b) =>
			MEMBER_GROUPS.indexOf(a.data.group) - MEMBER_GROUPS.indexOf(b.data.group) || byOrder(a, b)
	)
---

<Base
	title="メンバー紹介"
	description={`${SITE_NAME}（${SITE_SHORT_NAME}）の部員と、顧問・メンターの紹介です。`}
>
	<div class="members-page">
		<Crumbs crumbs={[{ label: 'ホーム', href: '/' }, { label: 'メンバー' }]} />

		<Paper
			sideText={`MEET THE TEAM — VOL.${volume} — ${year}`}
			footText={[`VOL.${volume}`, 'HOKUDAI MED AI MAGAZINE']}
		>
			<SectionHead as="h1" num={`VOL.${volume}`} en="Members" ja="メンバー紹介" />

			<Banner count={students.length} volume={volume} year={year} />

			{students.length > 0 && (
				<div class="roster">
					<div class="band" aria-hidden="true" />
					<ul class="grid">
						{students.map(({ member, grade }, i) => (
							<MemberCard member={member} grade={grade} tone={toneOf(grade)} index={i} />
						))}
					</ul>
				</div>
			)}

			{staff.length > 0 && (
				<div class="staff">
					<h2 class="staff-tag">顧問・メンター</h2>
					<ul class="staff-grid">
						{staff.map((member, i) => (
							<StaffCard member={member} tone={i % 2 === 0 ? 'violet' : 'teal'} />
						))}
					</ul>
				</div>
			)}
		</Paper>

		<aside class="outro" aria-label="見学の案内">
			<div class="outro-inner">
				<p class="outro-en" lang="en" aria-hidden="true">
					Join us
				</p>
				<p class="outro-lead">学年・学部・経験は問いません。まずは見学から。</p>
				<div class="outro-actions">
					<a class="outro-button is-solid" href="/#join">
						見学を申し込む →
					</a>
					<a class="outro-button" href="/">
						トップページ
					</a>
				</div>
			</div>
		</aside>
	</div>
</Base>

<style>
	/* ---- 紙面。上にはみ出すリングのぶん、パンくずとの間を空ける ---- */

	.members-page :global(.paper-page) {
		margin-top: 40px;
	}

	/* ---- 部員の一覧 ---- */

	.roster {
		position: relative;
		margin-top: 56px;
	}

	/* 一覧の後ろを横切る斜めの帯。左右は紙面の端で切れる */
	.band {
		position: absolute;
		z-index: -1;
		top: 44px;
		left: 50%;
		width: 130vw;
		margin-left: -65vw;
		height: 300px;
		background: var(--band-teal);
		border-top: 10px solid var(--violet);
		transform: rotate(-4deg);
		pointer-events: none;
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 48px 26px;
		align-items: start;
	}

	/* ---- 顧問・メンター ---- */

	.staff {
		margin-top: 88px;
	}

	.staff-tag {
		display: inline-block;
		margin: 0;
		background: var(--teal);
		border: 3px solid var(--teal-ink);
		border-radius: var(--radius-frame);
		padding: 8px 22px;
		transform: rotate(-3deg);
		box-shadow: var(--shadow-hard-violet-sm);
		font-size: 24px;
		font-weight: 900;
		line-height: 1.3;
		color: #fff;
	}

	.staff-grid {
		list-style: none;
		margin: 32px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
		gap: 26px;
	}

	/* ---- 締めの案内 (青緑の地の上) ---- */

	.outro {
		padding: 64px var(--gutter) 72px;
		color: var(--on-teal);
	}

	.outro-inner {
		max-width: var(--content-width);
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 18px 32px;
	}

	.outro-en {
		margin: 0;
		font-family: var(--font-en);
		font-size: clamp(30px, 3.8vw, 44px);
		font-weight: 800;
		line-height: 1;
		letter-spacing: 0.01em;
		color: #fff;
	}

	.outro-lead {
		flex: 1 1 14em;
		margin: 0;
		font-size: 17px;
		font-weight: 700;
		line-height: 1.8;
		/* 文節の途中で折り返さない (対応ブラウザのみ) */
		word-break: auto-phrase;
	}

	.outro-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.outro-button {
		display: inline-flex;
		align-items: center;
		padding: 12px 24px;
		border: 2px solid rgba(255, 255, 255, 0.85);
		border-radius: var(--radius-pill);
		color: #fff;
		font-size: 15px;
		font-weight: 700;
		line-height: 1.4;
		transition:
			background 0.2s,
			color 0.2s,
			transform 0.2s var(--ease-out);
	}

	.outro-button:hover {
		background: rgba(255, 255, 255, 0.18);
		color: #fff;
		transform: translateY(-2px);
	}

	.outro-button.is-solid {
		border-color: var(--surface);
		background: var(--surface);
		color: var(--teal-ink);
		box-shadow: var(--shadow-sm);
	}

	.outro-button.is-solid:hover {
		background: var(--surface);
		color: var(--violet-strong);
	}

	.outro-button:focus-visible {
		outline: 3px solid var(--highlight);
		outline-offset: 3px;
	}

	@media (max-width: 980px) {
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.members-page :global(.paper-page) {
			margin-top: 30px;
		}

		.roster {
			margin-top: 44px;
		}

		.band {
			top: 60px;
			height: 240px;
		}

		.grid {
			gap: 30px 16px;
		}

		.staff {
			margin-top: 68px;
		}

		.staff-tag {
			font-size: 19px;
			padding: 6px 18px;
			border-radius: 16px;
		}

		.staff-grid {
			margin-top: 26px;
			gap: 20px;
		}

		.outro {
			padding: 44px var(--gutter) 52px;
		}

		.outro-lead {
			flex-basis: 100%;
			font-size: 16px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.outro-button {
			transition: none;
		}

		.outro-button:hover {
			transform: none;
		}
	}
</style>
