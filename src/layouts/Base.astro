---
import { Font } from 'astro:assets'
import SiteNav from '../components/SiteNav.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { SITE_DESCRIPTION, SITE_NAME, SITE_SHORT_NAME, X_ACCOUNT } from '../lib/site'
import '../styles/tokens.css'

interface Props {
	/** ページ名。サイト名は自動で後ろに付く。トップページは省略する */
	title?: string
	description?: string
	/** SNS で共有されたときに出る画像の URL (サイト内パスか絶対 URL)。省略すると既定の画像 (public/og.png) */
	image?: string
	pageType?: 'website' | 'article'
	/** 検索に載せないページ (404 など) */
	noindex?: boolean
}

const {
	title,
	description = SITE_DESCRIPTION,
	image,
	pageType = 'website',
	noindex = false,
} = Astro.props

const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME
const canonical = new URL(Astro.url.pathname, Astro.site)

// SNS (X・Instagram・LINE・Discord など) で共有されたときのカード。どれも下の og:* を読む。
// 画像を持たないページには既定の画像を出す。元は scripts/og-card.html (撮り直し方もそこ)
const DEFAULT_IMAGE = {
	src: '/og.png',
	width: 1200,
	height: 630,
	alt: `${SITE_NAME}（${SITE_SHORT_NAME}）`,
}
const imageUrl = new URL(image ?? DEFAULT_IMAGE.src, Astro.site)

// 先読み: ブラウザ標準の Speculation Rules。サイト内リンクに hover (タッチは押した瞬間) で prerender しておき、
// 遷移を即座にする。未対応ブラウザ (Firefox / Safari) では無視される。
// ページの <script> は prerender 時にも走るので、表示されてから動かす処理は document.prerendering に注意する
const speculationRules = {
	prerender: [
		{
			source: 'document',
			where: {
				and: [
					{ href_matches: '/*' },
					{ not: { selector_matches: '[target=_blank], [download], [rel~=nofollow]' } },
				],
			},
			eagerness: 'moderate',
		},
	],
}
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:type" content={pageType} />
		<meta property="og:title" content={title ?? SITE_NAME} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		{!image && (
			<>
				<meta property="og:image:width" content={String(DEFAULT_IMAGE.width)} />
				<meta property="og:image:height" content={String(DEFAULT_IMAGE.height)} />
				<meta property="og:image:alt" content={DEFAULT_IMAGE.alt} />
			</>
		)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={`@${X_ACCOUNT}`} />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-display" />
		<script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />
	</head>
	<body>
		<SiteNav />
		<main>
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
